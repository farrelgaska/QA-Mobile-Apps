# Local file-backed development (default)
DATA_PROVIDER=json
PORT=3002
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional demo authentication token guard for prototype/pilot phase
ADMIN_DEMO_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# PostgreSQL mode through the Supabase transaction pooler. Placeholders only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=2
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_KEEP_ALIVE=true
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# QC Evidence Storage Provider.
# Use 'supabase' for production/remote storage.
# Use 'local' to store files on the local filesystem under mock-api/.local-storage.
STORAGE_PROVIDER=local
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
